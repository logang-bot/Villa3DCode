# Normalize all text files to LF in the repo
* text=auto eol=lf

# C# source
*.cs        text eol=lf
*.cs.meta   text eol=lf
# Unity YAML (scenes, prefabs, assets, etc.)
*.unity             text eol=lf
*.prefab            text eol=lf
*.asset             text eol=lf
*.mat               text eol=lf
*.anim              text eol=lf
*.controller        text eol=lf
*.overrideController text eol=lf
*.physicsMaterial   text eol=lf
*.physicsMaterial2D text eol=lf
*.playable          text eol=lf
*.meta              text eol=lf
*.inputactions      text eol=lf
# Config / data
*.asmdef    text eol=lf
*.asmref    text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.txt       text eol=lf
*.md        text eol=lf
# Shaders
*.shader    text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.glsl      text eol=lf
# ---- Binary files — no line ending conversion ----
# Images
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.bmp       binary
*.tga       binary
*.tif       binary
*.tiff      binary
*.psd       binary
*.hdr       binary
*.exr       binary
# 3D / audio / video
*.fbx       binary
*.obj       binary
*.blend     binary
*.3ds       binary
*.dae       binary
*.mp3       binary
*.wav       binary
*.ogg       binary
*.aif       binary
*.aiff      binary
*.mp4       binary
*.mov       binary
*.avi       binary
# Compiled / packages
*.dll       binary
*.exe       binary
*.pdb       binary
*.mdb       binary
*.unitypackage binary
*.zip       binary
# Fonts
*.ttf       binary
*.otf       binary
*.cubemap   binary
